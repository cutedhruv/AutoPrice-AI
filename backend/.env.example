GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1
DATABASE_URL=sqlite:///./autoprice.db
AGENT_LOOP_INTERVAL=15

# Per-product pipeline: LangGraph graph vs sequential orchestrator (true|false)
USE_LANGGRAPH_PIPELINE=true

# Market: LangChain always first; SK optional before direct tools/ (true|false)
USE_MARKET_SEMANTIC_KERNEL=true

# Data / Pricing (rules) / Risk / Execution: LangChain first; SK optional (true|false)
USE_AGENT_SEMANTIC_KERNEL=true

# Register Groq chat on the shared Semantic Kernel instance (true|false)
SEMANTIC_KERNEL_CHAT_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
